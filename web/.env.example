# ---------------------------------------------------------------------------
# MetaMage web — environment. Copy to `.env.local` and fill in.
# Every var here is optional in development: the app boots on the committed
# fixture data with no external services. NEXT_PUBLIC_* vars are inlined into
# the client bundle at build time, so set them before `pnpm build`.
# ---------------------------------------------------------------------------

# Which backend getDataSource() resolves (src/datasource/index.ts).
#   fixtures  — committed seeded JSON (default; the only backend that exists today)
#   postgres  — Neon read-path, deferred (blueprint §8); currently falls back to
#               fixtures so setting this does not break the app.
DATA_SOURCE=fixtures

# Absolute origin of the deployed site. Drives metadataBase (canonical URLs,
# OpenGraph image URLs), robots.ts Host, and sitemap.ts <loc> entries. Set this
# to the real subdomain in production. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostHog product analytics. Without a key, analytics is a no-op (the
# `reparameterize` capture at the LensBar choke point silently does nothing) and
# nothing is loaded on the client — safe to leave blank in dev.
NEXT_PUBLIC_POSTHOG_KEY=
# Optional PostHog ingestion host; defaults to https://us.i.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
