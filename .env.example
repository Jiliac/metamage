DISCORD_BOT_TOKEN=XXX
ANTHROPIC_API_KEY=XXXXX
GOOGLE_API_KEY=XXXXX

DISCORD_MAGEBRIDGE_TOKEN=
BLUESKY_USERNAME=
BLUESKY_PASSWORD=

# Ops DB (chat/social telemetry) — Postgres when set, else SQLite fallback.
POSTGRES_URL=

# Tournament DB (domain data). When set, the model layer, MCP server, ingest,
# Alembic, and the R viz all use Postgres; unset falls back to the local SQLite
# file (dev). Point at the SELECT-only role for read consumers (MCP, R):
#   TOURNAMENT_DATABASE_URL=postgresql://metamage_ro:...@ep-xyz.neon.tech/tournament?sslmode=require
# The ingest process instead sets TOURNAMENT_DATABASE_URL to the read/write role.
TOURNAMENT_DATABASE_URL=
# Optional: lets an otherwise-read-only process (the MCP server) perform its one
# write path (archetype aliases) via the read/write role.
TOURNAMENT_DATABASE_WRITE_URL=

# Twitter/X API credentials
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Client is v2. Are not used ATM
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Twitter notification polling (Phase 2c)
# Free tier: 1 req/15min = 900 seconds
# Basic tier ($200/month): 10 req/15min = 90 seconds
TWITTER_POLL_INTERVAL_SECONDS=900
# Backoff time after hitting 429 rate limit
TWITTER_RATE_LIMIT_BACKOFF_SECONDS=300

NEBIUS_API_KEY=
